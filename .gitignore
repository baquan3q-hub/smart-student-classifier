# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual Environments
.venv/
venv/
ENV/
env/

# IDEs
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Keep folder structures but ignore their generated contents
data/raw/*
!data/raw/.gitkeep

data/processed/*
!data/processed/.gitkeep

models/*
!models/.gitkeep

reports/*
!reports/.gitkeep

assets/screenshots/*
!assets/screenshots/.gitkeep
